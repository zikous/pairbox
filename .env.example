# Local settings for pairbox. Copy this file to .env and adjust.
# Both the API server and the web dev server read .env from the repo root.

# API server
API_HOST=127.0.0.1
API_PORT=8742
# Bearer token needed to create and delete rooms. Use a long random value in production.
HOST_SECRET=dev

# Web dev server (forwards /api and /ws to the API server above)
WEB_PORT=5173
