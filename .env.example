# Local settings for pairbox. Copy this file to .env and adjust.
# docker compose and the services all read .env from the repo root.

# --- What you open in the browser -------------------------------------------------------------
# The app served by docker compose (web container).
WEB_PORT=8080
# The Vite dev server (pnpm dev), with hot reload. It talks to the api below.
DEV_PORT=5173
# Address put in invite links, e.g. https://pairbox.example.com. When empty, invite links use the
# Cloudflare tunnel's public address if the tunnel runs, else the address the app was opened on.
PUBLIC_URL=
# Extra docker compose services to start. "tunnel" makes the app reachable from any network;
# remove it to keep pairbox on this machine and network only.
COMPOSE_PROFILES=tunnel

# --- api ---------------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8742

# --- Between services --------------------------------------------------------------------------
# Shared secret the api, pool and workers use to trust each other. Use a long random value.
INTERNAL_SECRET=dev-internal
POOL_HOST=127.0.0.1
POOL_PORT=8743
POOL_URL=http://127.0.0.1:8743
WORKER_PORT=8744
# Only used when running a worker outside Docker (the images set it themselves).
WORKER_RUNTIME=python

# --- Database ----------------------------------------------------------------------------------
POSTGRES_USER=pairbox
POSTGRES_PASSWORD=pairbox
POSTGRES_DB=pairbox
POSTGRES_PORT=5432
# Used when running the api outside Docker, and by its tests.
DATABASE_URL=postgres://pairbox:pairbox@localhost:5432/pairbox
TEST_DATABASE_URL=postgres://pairbox:pairbox@localhost:5432/pairbox_test

# --- Session recordings (S3-compatible object storage) -------------------------------------
S3_BUCKET=pairbox-recordings
S3_ACCESS_KEY=pairbox
# Use a long random value in production.
S3_SECRET_KEY=pairbox-dev-secret
# Only used when running the api outside Docker.
S3_ENDPOINT=http://127.0.0.1:8333

# --- Scheduler -------------------------------------------------------------------------------
SCHEDULER_HOST=127.0.0.1
SCHEDULER_PORT=8745
# Only used when running the api outside Docker.
SCHEDULER_URL=http://127.0.0.1:8745
